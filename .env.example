# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------
# The base URL of the model endpoint. For local servers like LM Studio or Ollama,
# use their respective v1 endpoints.
# LM Studio: http://127.0.0.1:1234/v1
# Ollama: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# The API key to use for authentication. Use any string for local servers.
OPENAI_API_KEY=not-needed

# ---------------------------------------------------------------------------
# Model Configuration
# ---------------------------------------------------------------------------
# Default model to use for the simulation (e.g. granite-4.1-3b, gpt-4o-mini, etc.)
ROBITS_MODEL=granite-4.1-3b

# Model for spawned sub-agents
ROBITS_SPAWN_MODEL=functiongemma-270m-it

# Model for embedding search. Leave empty to disable semantic search.
ROBITS_EMBEDDING_MODEL=google/embedding-gemma-300m

# ---------------------------------------------------------------------------
# Environment Options
# ---------------------------------------------------------------------------
# Forces Python to use UTF-8 encoding for standard input/output on Windows.
PYTHONUTF8=1
